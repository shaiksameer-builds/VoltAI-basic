# ============================================================
# VoltAI — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.
# ============================================================

# -------------------- Application --------------------
APP_NAME=VoltAI
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# -------------------- Backend Server --------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# -------------------- Database --------------------
# DATABASE_URL=postgresql://user:password@localhost:5432/voltai_db

# -------------------- External APIs --------------------
# WEATHER_API_KEY=
# WEATHER_API_BASE_URL=

# -------------------- AI / ML --------------------
# MODEL_STORAGE_PATH=./ml/models

# -------------------- Frontend --------------------
# REACT_APP_API_URL=http://localhost:8000/api

# -------------------- Security --------------------
# SECRET_KEY=
# JWT_ALGORITHM=HS256
# JWT_EXPIRATION_MINUTES=60
