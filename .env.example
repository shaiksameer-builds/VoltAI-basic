# ============================================================
# VoltAI — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.
# ============================================================

# -------------------- Application --------------------
APP_NAME=VoltAI
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# -------------------- Backend Server --------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# -------------------- Database --------------------
# DATABASE_URL=postgresql://user:password@localhost:5432/voltai_db

# -------------------- Weather Integration --------------------
# WEATHER_PROVIDER: Weather provider adapter ('open_meteo', 'visual_crossing', etc.). Default: open_meteo
WEATHER_PROVIDER=open_meteo
# WEATHER_API_KEY: API key for key-required providers (Optional for open_meteo)
WEATHER_API_KEY=
# WEATHER_API_BASE_URL: Override provider base API URL if needed
WEATHER_API_BASE_URL=https://archive-api.open-meteo.com/v1/archive
# WEATHER_TIMEOUT_SECONDS: HTTP client timeout in seconds (Default: 30)
WEATHER_TIMEOUT_SECONDS=30
# WEATHER_MAX_RETRIES: Retries for transient HTTP errors (Default: 3)
WEATHER_MAX_RETRIES=3

# -------------------- AI / ML --------------------
# MODEL_STORAGE_PATH=./ml/models

# -------------------- Frontend --------------------
# REACT_APP_API_URL=http://localhost:8000/api

# -------------------- Security --------------------
# SECRET_KEY=
# JWT_ALGORITHM=HS256
# JWT_EXPIRATION_MINUTES=60
